{
  "name": "ai-usage-snippet",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-account AI usage dashboard. Claude today, more providers later.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node -e \"if (require('node:fs').existsSync('node_modules/electron')) require('node:child_process').execFileSync(process.execPath, ['node_modules/electron/install.js'], { stdio: 'inherit' })\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "start": "npm run build:frontend && npm run start --workspace backend",
    "tray": "npm run build:frontend && electron ."
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "menubar": "^9.5.1"
  }
}
